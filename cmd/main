#!/bin/sh

set -u

export PATH="/var/apps/nodejs_v22/target/bin:${PATH:-/usr/bin:/bin}"

APP_DEST="${TRIM_APPDEST:-$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)}"
PKG_VAR="${TRIM_PKGVAR:-$APP_DEST/var}"
PKG_ETC="${TRIM_PKGETC:-$APP_DEST/etc}"
PKG_TMP="${TRIM_PKGTMP:-$APP_DEST/tmp}"
PID_FILE="$PKG_TMP/zhenshu.pid"
LOG_FILE="$PKG_VAR/zhenshu.log"
SOCKET_FILE="$APP_DEST/app.sock"
SERVER_FILE="$APP_DEST/server/index.js"
NODEJS_DIR="/var/apps/nodejs_v22/target/bin"
# Process table root; overridable only so tests can supply a fake one.
PROC_ROOT="${ZHENSHU_PROC_ROOT:-/proc}"
SERVER_REAL=$(readlink -f "$SERVER_FILE" 2>/dev/null) || SERVER_REAL=$SERVER_FILE

report_error() {
  MESSAGE=$1
  if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
    printf '%s\n' "$MESSAGE" > "$TRIM_TEMP_LOGFILE" 2>/dev/null || true
  fi
  printf '%s\n' "$MESSAGE" >&2
}

find_node() {
  if [ -x "$NODEJS_DIR/node" ]; then
    NODE_BIN="$NODEJS_DIR/node"
  elif [ -x "$APP_DEST/bin/node" ]; then
    NODE_BIN="$APP_DEST/bin/node"
  else
    NODE_BIN=$(command -v node 2>/dev/null) || return 1
  fi

  [ -x "$NODE_BIN" ] || return 1
  "$NODE_BIN" -e 'process.exit(Number(process.versions.node.split(".")[0]) >= 22 ? 0 : 1)' >/dev/null 2>&1 || return 1
  printf '%s\n' "$NODE_BIN"
}

read_pid() {
  [ -r "$PID_FILE" ] || return 1
  IFS= read -r PID < "$PID_FILE" || return 1
  case "$PID" in
    ''|*[!0-9]*) return 1 ;;
  esac
  [ "$PID" -gt 1 ] 2>/dev/null || return 1
  return 0
}

# True when process $1 runs this package's server: one of its arguments is
# SERVER_FILE, either verbatim or through a different path to the same file
# (fnOS may launch it via the resolved app-center directory).
is_server_pid() {
  CMDLINE_FILE="$PROC_ROOT/$1/cmdline"
  [ -r "$CMDLINE_FILE" ] || return 1
  tr '\000' '\n' < "$CMDLINE_FILE" 2>/dev/null | {
    while IFS= read -r ARG; do
      case "$ARG" in
        */server/index.js) ;;
        *) continue ;;
      esac
      [ "$ARG" = "$SERVER_FILE" ] && exit 0
      [ "$(readlink -f "$ARG" 2>/dev/null)" = "$SERVER_REAL" ] && exit 0
    done
    exit 1
  }
}

# Finds the server by scanning the process table, for when the PID file is
# missing or stale (fnOS may supervise the process or clear the temp dir).
find_server_pid() {
  for ENTRY in "$PROC_ROOT"/[0-9]*; do
    CANDIDATE=${ENTRY##*/}
    case "$CANDIDATE" in
      ''|*[!0-9]*) continue ;;
    esac
    [ "$CANDIDATE" = "$$" ] && continue
    if is_server_pid "$CANDIDATE"; then
      PID=$CANDIDATE
      return 0
    fi
  done
  return 1
}

is_running() {
  if read_pid && kill -0 "$PID" 2>/dev/null; then
    if [ ! -r "$PROC_ROOT/$PID/cmdline" ] || is_server_pid "$PID"; then
      return 0
    fi
  fi

  # The PID file cannot vouch for the server; look for it directly so status
  # does not report a running service as stopped and start does not launch a
  # second copy over its socket. Re-adopt the PID for later stop/status calls.
  find_server_pid || return 1
  if mkdir -p "$PKG_TMP" 2>/dev/null && printf '%s\n' "$PID" > "$PID_FILE" 2>/dev/null; then
    chmod 600 "$PID_FILE" 2>/dev/null || true
  fi
  return 0
}

remove_stale_state() {
  rm -f "$PID_FILE" "$SOCKET_FILE"
}

start_service() {
  if is_running; then
    [ -S "$SOCKET_FILE" ] && return 0
    report_error "枕书 进程正在运行，但 Unix Socket 不存在：$SOCKET_FILE"
    return 1
  fi

  remove_stale_state

  NODE_BIN=$(find_node) || {
    report_error "未找到可用的 Node.js 22 运行时。请确认依赖 nodejs_v22 已安装且 $NODEJS_DIR/node 可执行。"
    return 1
  }

  if [ ! -f "$SERVER_FILE" ]; then
    report_error "枕书 服务文件不存在：$SERVER_FILE"
    return 1
  fi

  mkdir -p "$PKG_VAR" "$PKG_ETC" "$PKG_TMP" || {
    report_error "无法创建 枕书 运行目录。"
    return 1
  }
  chmod 700 "$PKG_VAR" "$PKG_ETC" "$PKG_TMP" 2>/dev/null || true

  : >> "$LOG_FILE" || {
    report_error "无法写入 枕书 日志：$LOG_FILE"
    return 1
  }

  TRIM_APPDEST="$APP_DEST" \
  TRIM_PKGVAR="$PKG_VAR" \
  TRIM_PKGETC="$PKG_ETC" \
  TRIM_PKGTMP="$PKG_TMP" \
  TRIM_DATA_ACCESSIBLE_PATHS="${TRIM_DATA_ACCESSIBLE_PATHS:-}" \
  ZHENSHU_FNOS_ACCESSIBLE_AT_START="${TRIM_DATA_ACCESSIBLE_PATHS+1}" \
  TRIM_DATA_SHARE_PATHS="${TRIM_DATA_SHARE_PATHS:-}" \
  ZHENSHU_SOCKET="$SOCKET_FILE" \
  ZHENSHU_ENABLE_LIBRARY_ORGANIZATION="${ZHENSHU_ENABLE_LIBRARY_ORGANIZATION:-1}" \
  ZHENSHU_ENABLE_AI_CHAPTER_UNDERSTANDING="${ZHENSHU_ENABLE_AI_CHAPTER_UNDERSTANDING:-0}" \
  NODE_ENV=production \
    nohup "$NODE_BIN" "$SERVER_FILE" >> "$LOG_FILE" 2>&1 </dev/null &

  PID=$!
  case "$PID" in
    ''|*[!0-9]*)
      report_error "枕书 启动后未获得有效 PID。"
      remove_stale_state
      return 1
      ;;
  esac

  if ! printf '%s\n' "$PID" > "$PID_FILE"; then
    kill "$PID" 2>/dev/null || true
    report_error "无法写入 枕书 PID 文件：$PID_FILE"
    remove_stale_state
    return 1
  fi
  chmod 600 "$PID_FILE" 2>/dev/null || true

  ATTEMPTS=0
  while [ "$ATTEMPTS" -lt 100 ]; do
    if ! kill -0 "$PID" 2>/dev/null; then
      wait "$PID" 2>/dev/null || true
      remove_stale_state
      report_error "枕书 服务启动失败，请检查日志：$LOG_FILE"
      return 1
    fi
    if [ -S "$SOCKET_FILE" ]; then
      return 0
    fi
    ATTEMPTS=$((ATTEMPTS + 1))
    sleep 0.1
  done

  kill "$PID" 2>/dev/null || true
  ATTEMPTS=0
  while kill -0 "$PID" 2>/dev/null && [ "$ATTEMPTS" -lt 50 ]; do
    ATTEMPTS=$((ATTEMPTS + 1))
    sleep 0.1
  done
  kill -9 "$PID" 2>/dev/null || true
  remove_stale_state
  report_error "枕书 Unix Socket 未在预期时间内创建：$SOCKET_FILE"
  return 1
}

stop_service() {
  if ! is_running; then
    remove_stale_state
    return 0
  fi

  STOP_PID=$PID
  if ! kill "$STOP_PID" 2>/dev/null; then
    report_error "无法停止 枕书 进程：$STOP_PID"
    return 1
  fi

  ATTEMPTS=0
  while kill -0 "$STOP_PID" 2>/dev/null && [ "$ATTEMPTS" -lt 100 ]; do
    ATTEMPTS=$((ATTEMPTS + 1))
    sleep 0.1
  done

  if kill -0 "$STOP_PID" 2>/dev/null; then
    kill -9 "$STOP_PID" 2>/dev/null || {
      report_error "无法强制停止 枕书 进程：$STOP_PID"
      return 1
    }
  fi

  remove_stale_state
  return 0
}

status_service() {
  if is_running && [ -S "$SOCKET_FILE" ]; then
    return 0
  fi
  return 3
}

case "${1:-}" in
  start)
    start_service
    ;;
  stop)
    stop_service
    ;;
  restart)
    stop_service && start_service
    ;;
  status)
    status_service
    ;;
  *)
    # fnOS lifecycle contract: 0 success/running, 1 failure, 3 not running.
    printf 'Usage: %s {start|stop|restart|status}\n' "$0" >&2
    exit 1
    ;;
esac
