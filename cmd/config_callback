#!/bin/sh

set -eu

APP_DEST="${TRIM_APPDEST:-$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)}"
PKG_ETC="${TRIM_PKGETC:-$APP_DEST/etc}"

NODE_BIN=/var/apps/nodejs_v22/target/bin/node
if [ ! -x "$NODE_BIN" ]; then
  NODE_BIN=$(command -v node) || {
    printf '%s\n' 'Node.js 22 is required to apply BabyReader configuration.' >&2
    exit 1
  }
fi

if [ "${wizard_pdf_reader_enabled+x}" = x ]; then
  TRIM_PKGETC="$PKG_ETC" "$NODE_BIN" "$APP_DEST/server/pdf-feature-config.js" set "$wizard_pdf_reader_enabled"
fi

if [ "${wizard_mobi_reader_enabled+x}" = x ]; then
  TRIM_PKGETC="$PKG_ETC" "$NODE_BIN" "$APP_DEST/server/mobi-feature-config.js" set "$wizard_mobi_reader_enabled"
fi

TRIM_DATA_ACCESSIBLE_PATHS="${TRIM_DATA_ACCESSIBLE_PATHS:-}" TRIM_PKGETC="$PKG_ETC" \
  "$NODE_BIN" "$APP_DEST/server/fnos-roots-config.js" set || {
  MESSAGE="无法保存 fnOS 书库授权状态；请检查应用配置目录权限。"
  [ -n "${TRIM_TEMP_LOGFILE:-}" ] && printf '%s\n' "$MESSAGE" > "$TRIM_TEMP_LOGFILE"
  printf '%s\n' "$MESSAGE" >&2
  exit 1
}

exit 0
