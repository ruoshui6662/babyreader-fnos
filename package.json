{
  "name": "zhenshu",
  "version": "0.0.26",
  "description": "枕书 EPUB, Markdown and TXT reader for fnOS",
  "main": "app/server/index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "dev": "node app/server/index.js",
    "render:icons": "node scripts/render-icons.js",
    "test": "node --test tests/*.test.js",
    "test:core": "node --test tests/dom-regression.test.js tests/reader-core.test.js tests/security.test.js tests/structure-validation.test.js",
    "test:lifecycle": "node --test tests/fnos-lifecycle.test.js",
    "check": "node scripts/validate-structure.js",
    "check:portable": "node scripts/validate-structure.js --portable",
    "check:posix": "node scripts/validate-structure.js --posix",
    "test:e2e": "playwright test --project=chromium && npm run test:e2e:organization",
    "test:e2e:organization": "node scripts/test-library-organization-e2e.js",
    "build:fpk": "bash scripts/build-fpk.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@lingo-reader/shared": "0.4.6",
    "fflate": "^0.8.3",
    "pdfjs-dist": "6.3.289",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "happy-dom": "^20.14.5"
  }
}
