<?xml version="1.0" encoding="utf-8"?>
<!-- A NAS on the home network usually has no certificate: allow plain HTTP.
     HTTPS keeps normal certificate checks (no self-signed bypass). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
